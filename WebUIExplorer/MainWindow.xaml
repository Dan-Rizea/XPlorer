<Window x:Class="WebUIExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="XPlorer" Height="460" Width="260"
        MinHeight="145" MinWidth="180"
        Loaded="Window_Loaded" Topmost="True"
        KeyDown="Window_KeyDown"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="#0F1013"
        BorderBrush="#252733"
        BorderThickness="1"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextElement.Foreground="#E5E7EB"
        TextElement.FontWeight="Medium"
        TextElement.FontSize="12"
        FontFamily="Segoe UI, Inter, Roboto, Arial">
    
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Clean Dark ScrollBar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="5"/>
        </Style>

        <!-- Window Caption Button Styles -->
        <Style x:Key="CaptionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#8F96A3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#252733"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A1C24"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseCaptionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#8F96A3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E11D48"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#BE123C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- White Icon Button Style (Indicate Element) -->
        <Style x:Key="WhiteIconBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Header / Small Action Button Style -->
        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1F2026"/>
            <Setter Property="BorderBrush" Value="#2C2E3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#D1D5DB"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A2C37"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#3D4152"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#181920"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Responsive Segmented Icon Button Style (Shared between Top and Bottom Bars) -->
        <Style x:Key="SegmentedActionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#8F96A3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#252733"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#3B3F52"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A1C24"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tool Icon Button Style (Row actions & small utilities) -->
        <Style x:Key="ToolIconBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#8F96A3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#252733"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A1C24"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Window Layout -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Dark Window Title Bar with Action History / Live Status -->
        <Grid Grid.Row="0" Height="32" Background="#0C0D10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Action History / Live Status Display in Title Bar -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,4,0" ClipToBounds="True">
                <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#22C55E" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusTextBlock" 
                           Text="Ready" 
                           TextTrimming="CharacterEllipsis"
                           Foreground="#9CA3AF" 
                           VerticalAlignment="Center" 
                           FontSize="11" 
                           FontWeight="Medium"/>
            </StackPanel>

            <!-- Window Caption Buttons (Minimize, Maximize, Close) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionBtnStyle}" Click="MinimizeWindow_Click" ToolTip="Minimize">
                    <materialDesign:PackIcon Kind="WindowMinimize" Width="10" Height="10"/>
                </Button>
                <Button Style="{StaticResource CaptionBtnStyle}" Click="MaximizeWindow_Click" ToolTip="Maximize / Restore">
                    <materialDesign:PackIcon x:Name="MaximizeIcon" Kind="WindowMaximize" Width="10" Height="10"/>
                </Button>
                <Button Style="{StaticResource CloseCaptionBtnStyle}" Click="CloseWindow_Click" ToolTip="Close">
                    <materialDesign:PackIcon Kind="Close" Width="11" Height="11"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- App Body Content (Fully Responsive) -->
        <Grid Grid.Row="1" Margin="10,8,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition x:Name="MiddleSeparatorRow1" Height="8"/>
                <RowDefinition x:Name="SavedSelectorsRow" Height="*"/>
                <RowDefinition x:Name="MiddleSeparatorRow2" Height="8"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Top Unified Toolbar: 5-Column Responsive Grid matching Bottom Dock -->
            <Border Grid.Row="0" HorizontalAlignment="Stretch" Background="#141519" BorderBrush="#22242D" BorderThickness="1" CornerRadius="8" Padding="3">
                <Border Background="#181920" BorderBrush="#272A36" BorderThickness="1" CornerRadius="6" Padding="2">
                    <UniformGrid Rows="1">
                        <!-- Indicate Element Button (White Accent Icon) -->
                        <Button x:Name="SpyButton" 
                                Style="{StaticResource WhiteIconBtnStyle}"
                                Click="SpyButton_Click"
                                ToolTip="Indicate Element: Alt+Wheel or Tab cycles layers; Up/Down selects parent/child; Click or Enter captures; Esc cancels.">
                            <materialDesign:PackIcon x:Name="SpyIcon" Kind="CrosshairsGps" Width="15" Height="15" Foreground="#000000"/>
                        </Button>

                        <!-- Cycle Timer Button (Instant / 3s / 5s / 10s) -->
                        <Button x:Name="TimerCycleButton" 
                                Style="{StaticResource SegmentedActionBtnStyle}"
                                Click="TimerCycleButton_Click"
                                ToolTip="Delay Timer: 0s (Click to cycle 0s -> 3s -> 5s -> 10s)">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="TimerOutline" Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                <TextBlock x:Name="TimerText" Text="0s" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Toggle Selectors Panel (Mini Mode) -->
                        <Button Style="{StaticResource SegmentedActionBtnStyle}" 
                                Click="ToggleSavedSelectors_Click" 
                                ToolTip="Toggle Saved Selectors Panel">
                            <materialDesign:PackIcon x:Name="TogglePanelDockIcon" Kind="ChevronDoubleDown" Width="15" Height="15"/>
                        </Button>

                        <!-- Chrome Focus Button -->
                        <Button x:Name="ChromeButton"
                                Style="{StaticResource SegmentedActionBtnStyle}" 
                                Click="ChromeButton_Click" 
                                ToolTip="Bring Chrome Browser to Forefront">
                            <materialDesign:PackIcon Kind="GoogleChrome" Width="15" Height="15"/>
                        </Button>

                        <!-- Topmost / Window Pin Button -->
                        <Button x:Name="PinWindowButton"
                                Style="{StaticResource SegmentedActionBtnStyle}" 
                                Click="PinWindowButton_Click" 
                                ToolTip="Window Pinned (Always on Top)">
                            <materialDesign:PackIcon x:Name="PinWindowIcon" Kind="Pin" Width="15" Height="15" Foreground="#38BDF8"/>
                        </Button>
                    </UniformGrid>
                </Border>
            </Border>

            <!-- Main Card: Saved Selectors Repository (Stretches Responsively) -->
            <Border x:Name="SavedSelectorsCard" 
                    Grid.Row="2" 
                    HorizontalAlignment="Stretch"
                    Background="#141519" 
                    BorderBrush="#22242D" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="8,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Card Header with Hide / Collapse Button -->
                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource ToolIconBtnStyle}" 
                                    Height="18" Width="18" Margin="0,0,4,0"
                                    Click="ToggleSavedSelectors_Click" 
                                    ToolTip="Hide Selectors Panel">
                                <materialDesign:PackIcon x:Name="CollapseHeaderIcon" Kind="ChevronUp" Width="13" Height="13"/>
                            </Button>
                            <TextBlock x:Name="SavedSelectorsTitleBlock" Text="Saved Selectors (0)" FontWeight="SemiBold" FontSize="11" Foreground="#E5E7EB" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <Button Height="20" Padding="6,0" 
                                HorizontalAlignment="Right" 
                                Style="{StaticResource HeaderButtonStyle}"
                                Click="ClearAllElements_Click" 
                                ToolTip="Clear all saved selectors">
                            <TextBlock Text="Clear All" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <!-- Table Header Row -->
                    <Grid Grid.Row="2" Margin="2,0">
                        <TextBlock Text="Name" Foreground="#8F96A3" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBlock Text="Actions" Foreground="#8F96A3" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Divider below headers -->
                    <Rectangle Grid.Row="3" Height="1" Fill="#20222B" HorizontalAlignment="Stretch" Margin="0,2,0,0"/>

                    <!-- Elements DataGrid List -->
                    <DataGrid x:Name="SavedElementsDataGrid" 
                              Grid.Row="4"
                              AutoGenerateColumns="False" 
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              HeadersVisibility="None"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#1E2028"
                              Background="Transparent"
                              RowBackground="Transparent"
                              BorderThickness="0"
                              materialDesign:DataGridAssist.CellPadding="2 3"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              SelectionChanged="SavedElementsDataGrid_SelectionChanged">
                        <DataGrid.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#1E293B"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#1A202C"/>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <!-- Editable Name Column (Stretches across all available width) -->
                            <DataGridTemplateColumn Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox x:Name="ElementNameBox"
                                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                                                 FontWeight="Bold" 
                                                 FontSize="11"
                                                 Foreground="#FFFFFF"
                                                 BorderThickness="0" 
                                                 Background="Transparent"
                                                 VerticalAlignment="Center"
                                                 Padding="2,1"
                                                 KeyDown="ElementNameBox_KeyDown"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Actions Column: Copy + Pencil + Trash -->
                            <DataGridTemplateColumn Width="66">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <!-- Copy Path Button -->
                                            <Button Style="{StaticResource ToolIconBtnStyle}" Click="RowCopy_Click" ToolTip="Copy Path">
                                                <materialDesign:PackIcon Kind="ContentCopy" Width="11" Height="11"/>
                                            </Button>

                                            <!-- Edit / Rename Button -->
                                            <Button Style="{StaticResource ToolIconBtnStyle}" Click="RowEdit_Click" ToolTip="Rename">
                                                <materialDesign:PackIcon Kind="PencilOutline" Width="11" Height="11"/>
                                            </Button>

                                            <!-- Delete Button -->
                                            <Button Style="{StaticResource ToolIconBtnStyle}" Click="RowDelete_Click" ToolTip="Delete">
                                                <materialDesign:PackIcon Kind="TrashCanOutline" Width="11" Height="11"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Bottom Action Bar (5-Column Responsive Grid matching Top Toolbar) -->
            <Border x:Name="BottomDockBorder" Grid.Row="4" HorizontalAlignment="Stretch" Background="#141519" BorderBrush="#22242D" BorderThickness="1" CornerRadius="8" Padding="3">
                <Grid>
                    <!-- Unified Action Buttons (UniformGrid with 5 Columns) -->
                    <Border Background="#181920" BorderBrush="#272A36" BorderThickness="1" CornerRadius="6" Padding="2">
                        <UniformGrid Rows="1">
                            <!-- Click Button -->
                            <Button x:Name="TestClickButton" 
                                    Style="{StaticResource SegmentedActionBtnStyle}"
                                    ToolTip="Click Element"
                                    Click="TestClickButton_Click">
                                <materialDesign:PackIcon Kind="GestureTap" Width="15" Height="15"/>
                            </Button>

                            <!-- Hover Button -->
                            <Button x:Name="TestHoverButton" 
                                    Style="{StaticResource SegmentedActionBtnStyle}"
                                    ToolTip="Hover Element (3s)"
                                    Click="TestHoverButton_Click">
                                <materialDesign:PackIcon Kind="HandPointingRight" Width="15" Height="15"/>
                            </Button>

                            <!-- Scroll Button -->
                            <Button x:Name="TestScrollButton" 
                                    Style="{StaticResource SegmentedActionBtnStyle}"
                                    ToolTip="Scroll to Element"
                                    Click="TestScrollButton_Click">
                                <materialDesign:PackIcon Kind="SwapVertical" Width="15" Height="15"/>
                            </Button>

                            <!-- Get Text Button -->
                            <Button x:Name="TestGetTextButton" 
                                    Style="{StaticResource SegmentedActionBtnStyle}"
                                    ToolTip="Get Text / Value"
                                    Click="TestGetTextButton_Click">
                                <materialDesign:PackIcon Kind="FormatLetterCase" Width="15" Height="15"/>
                            </Button>

                            <!-- Type Into Toggle Button (Rightmost Action Button) -->
                            <Button x:Name="TestTypeToggleButton" 
                                    Style="{StaticResource SegmentedActionBtnStyle}"
                                    ToolTip="Type / Clear Element Text"
                                    Click="TestTypeToggleButton_Click">
                                <materialDesign:PackIcon x:Name="TypeToggleIcon" Kind="KeyboardOutline" Width="15" Height="15"/>
                            </Button>
                        </UniformGrid>
                    </Border>

                    <!-- Text Input Popup (Spans full width of the bottom dock dynamically) -->
                    <Popup x:Name="TypeInputPopup" 
                           PlacementTarget="{Binding ElementName=BottomDockBorder}" 
                           Placement="Top" 
                           VerticalOffset="-6" 
                           AllowsTransparency="True" 
                           StaysOpen="False" 
                           PopupAnimation="Fade"
                           Closed="TypeInputPopup_Closed">
                        <Border Width="{Binding ActualWidth, ElementName=BottomDockBorder}"
                                Background="#181920" 
                                BorderBrush="#38BDF8" 
                                BorderThickness="1" 
                                CornerRadius="6" 
                                Padding="3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBox x:Name="TypeInputBox" 
                                         Grid.Column="0"
                                         Padding="6,3" 
                                         FontSize="11"
                                         Text="Test input" 
                                         Foreground="#E2E8F0"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                                         KeyDown="TypeInputBox_KeyDown"
                                         VerticalAlignment="Center"/>
                                
                                <!-- Enter / Send Type Button -->
                                <Button Grid.Column="1" 
                                        Style="{StaticResource ToolIconBtnStyle}" 
                                        Height="22" Width="22" Margin="2,0"
                                        Click="TestTypeButton_Click" 
                                        ToolTip="Send Text (Enter)">
                                    <materialDesign:PackIcon Kind="KeyboardReturn" Width="12" Height="12"/>
                                </Button>

                                <!-- Clear Element Text Button -->
                                <Button Grid.Column="2" 
                                        Style="{StaticResource ToolIconBtnStyle}" 
                                        Height="22" Width="22" Margin="0,0,2,0"
                                        Click="TestClearTextButton_Click" 
                                        ToolTip="Clear Element Text">
                                    <materialDesign:PackIcon Kind="BackspaceOutline" Width="12" Height="12"/>
                                </Button>

                                <!-- Close Popup Button -->
                                <Button Grid.Column="3" 
                                        Style="{StaticResource ToolIconBtnStyle}" 
                                        Height="22" Width="22" Margin="0,0,2,0"
                                        Click="CloseTypeInput_Click" 
                                        ToolTip="Close (Esc)">
                                    <materialDesign:PackIcon Kind="Close" Width="11" Height="11"/>
                                </Button>
                            </Grid>
                        </Border>
                    </Popup>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</Window>
